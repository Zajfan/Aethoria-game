{
  "name": "aethoria",
  "version": "0.9.0",
  "description": "Aethoria — Solo & Co-op Open World RPG",
  "main": "electron/main.js",
  "homepage": "https://github.com/Zajfan/Aethoria-game",
  "author": {
    "name": "The No-hands Company",
    "email": "contact@no-hands.company"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 8001",
    "build": "vite build && node scripts/post-build.js",
    "preview": "vite preview --port 8001",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n Vite,Electron -c cyan,yellow \"vite --port 8001\" \"wait-on http://localhost:8001 && cross-env NODE_ENV=development electron .\"",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:all": "npm run build && electron-builder --win --linux --mac",
    "cap:init": "cap init",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js"
  },
  "dependencies": {
    "three": "^0.165.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
