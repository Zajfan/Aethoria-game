<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron's JIT compiler (V8) under Hardened Runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Allow unsigned executable memory pages (needed by Chromium) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Disable library validation so Electron can load its own dylibs -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Network access for co-op server connections -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
